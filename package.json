{
  "name": "tree-sitter-lambdamoo",
  "version": "0.1.0",
  "description": "LambdaMOO grammar for tree-sitter",
  "repository": "https://github.com/kruton/tree-sitter-lambdamoo",
  "license": "MIT",
  "author": {
    "name": "Kenny Root",
    "email": "kenny@the-b.org"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "lambdamoo"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/**",
    "queries/*",
    "src/**"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-config-treesitter": "^1.0.0",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "^0.24.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "tree-sitter test && node --test bindings/node/*_test.js"
  }
}
